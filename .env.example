# Copy to .env (gitignored) and fill in. Never commit real values.

# ── Runtime safety (keep these as they are for customer traffic) ──
MILO_DISABLE_RUN_CODE=1          # RUN_CODE is not a sandbox. Always 1 for WhatsApp.

# ── Paths ──
# MILO_CONFIG_DIR=configs        # only if your configs live outside the repo
# MILO_MERCHANT_KB=merchant_kbs/kirana.json   # single-merchant local testing (milo-chat)
# MILO_INVARIANT_DATASET=data/tool_use_v51_train.jsonl   # dataset the invariant tests replay

# Offline / Docker: pre-cache the GPT-2 BPE files and point tiktoken at them.
# TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache

# ── WhatsApp Business Cloud API (Phase 4 — not used yet) ──
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
