# Experiments & checkpoints (large files)
/experiments/
*.pt
*.ptrom

# Training data (generated / downloaded)
/data/

# Local secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Logs
*.log
training.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Misc
*.bak
*.tmp
# Eval run artifacts
/eval_results/
